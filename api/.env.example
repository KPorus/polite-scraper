# Copy to .env and adjust:
#   cp .env.example .env

# Same Postgres as the polite scraper
DATABASE_URL=postgresql://scraper:scraper@localhost:5432/books

# Ollama (OpenAI-compatible). Swap these three to change provider.
LLM_BASE_URL=http://localhost:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=llama3.2:latest

# Stage 1 stub: skip the model, return schema-valid hard-coded JSON
LLM_STUB=0

# Kill switch: skip the model, return deterministic fallback
LLM_ENABLED=true
